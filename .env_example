# Telegram API (user) for reading
TG_API_ID=
TG_API_HASH=

# Telegram Bot API for posting
TG_BOT_TOKEN=
TG_TARGET_CHANNEL_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Storage paths (local defaults if unset)
DB_PATH=./.local/app.db
TELETHON_SESSION=./.local/telethon.session

# Runtime toggles
DRY_RUN=0
POST_TO_TELEGRAM=1
LOG_LEVEL=INFO
LLM_MODE=openai
